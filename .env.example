# Muslim Connect — environment configuration
# Copy to .env and fill in. NEVER commit .env with real secrets.

APP_NAME="Muslim Connect"
TAGLINE="One Ummah. One Community. Respect for All."
ENV=development

# REQUIRED in production: long random string, e.g. output of:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Database: SQLite default (dev). Postgres for production:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/muslim_connect
DATABASE_URL=sqlite:///./muslim_connect.db

ACCESS_TOKEN_EXPIRE_MINUTES=1440
GUEST_TOKEN_EXPIRE_MINUTES=360
GUEST_SESSION_TTL_HOURS=72

RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_MESSAGE_PER_MIN=20
RATE_LIMIT_API_PER_MIN=120

MAX_UPLOAD_MB=5

# Email (optional). Without SMTP, verification/reset links are printed to the
# server console in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@muslimconnect.app
FRONTEND_URL=http://localhost:8000

# First-run bootstrap admin: on startup, if NO admin exists yet, an admin
# account is created with these credentials. Remove after first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
